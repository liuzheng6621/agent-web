{
  "schema_version": "agent-web/0.1",
  "id": "coffee-sql/price-truth",
  "environment": {
    "adapter": "taixianglian-sql",
    "seed": {}
  },
  "task": {
    "natural_goal": "两杯拿铁的账必须和数据库里的单价对得上：明细行、小计、订单总额三处一致。",
    "goal_assertions": [
      {
        "kind": "field_equals",
        "selector": { "collection": "orders", "index": 0 },
        "path": "totalAmount",
        "value": 56
      },
      {
        "kind": "field_equals",
        "selector": { "collection": "orders", "index": 0 },
        "path": "items.0.count",
        "value": 2
      },
      {
        "kind": "field_equals",
        "selector": { "collection": "orders", "index": 0 },
        "path": "items.0.unitPrice",
        "value": 28
      },
      {
        "kind": "field_equals",
        "selector": { "collection": "orders", "index": 0 },
        "path": "items.0.subTotal",
        "value": 56
      },
      {
        "kind": "relation",
        "op": "product_equals",
        "selector": { "collection": "orders", "index": 0 },
        "items": "items",
        "left": "count",
        "right": "unitPrice",
        "path": "subTotal"
      },
      {
        "kind": "relation",
        "op": "sum_equals",
        "selector": { "collection": "orders", "index": 0 },
        "items": "items",
        "of": "subTotal",
        "path": "totalAmount"
      }
    ],
    "invariants": [
      {
        "kind": "unchanged",
        "scopes": ["menu"]
      }
    ]
  },
  "reference_trajectory": [
    {
      "id": "s1",
      "capability": "order.create",
      "as": "customer",
      "expected_outcome": "applied",
      "arguments": {
        "items": [
          { "dishName": "拿铁", "qty": 2 }
        ]
      }
    }
  ],
  "observability": {
    "declared_scopes": ["menu", "orders", "status_log"]
  }
}
