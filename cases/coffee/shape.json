{
  "schema_version": "agent-web/0.1",
  "id": "coffee/shape",
  "title": "集合形状：两条订单，看唯一性、类型、值域、顺序",
  "environment": {
    "adapter": "memory"
  },
  "task": {
    "natural_goal": "下两单（拿铁两份、美式咖啡三份），检查订单列表的形状",
    "goal_assertions": [
      {
        "kind": "entity_exists",
        "selector": {
          "collection": "orders",
          "index": 0
        }
      },
      {
        "kind": "count_delta",
        "selector": {
          "collection": "orders"
        },
        "delta": 2
      },
      {
        "kind": "unique",
        "selector": {
          "collection": "orders"
        },
        "path": "id"
      },
      {
        "kind": "type_of",
        "selector": {
          "collection": "orders"
        },
        "path": "totalAmount",
        "type": "number"
      },
      {
        "kind": "subset",
        "selector": {
          "collection": "orders"
        },
        "path": "status",
        "values": [
          "PENDING",
          "MAKING",
          "READY",
          "PICKED",
          "CANCELED"
        ]
      }
    ]
  },
  "reference_trajectory": [
    {
      "id": "s1",
      "capability": "order.create",
      "as": "customer",
      "arguments": {
        "items": [
          {
            "dishName": "拿铁",
            "count": 2
          }
        ]
      },
      "expected_outcome": "applied"
    },
    {
      "id": "s2",
      "capability": "order.create",
      "as": "customer",
      "arguments": {
        "items": [
          {
            "dishName": "美式咖啡",
            "count": 3
          }
        ]
      },
      "expected_outcome": "applied"
    }
  ],
  "invariants": []
}
