{
  "schema_version": "agent-web/0.1",
  "id": "coffee/skip-ready-stage",
  "environment": {
    "adapter": "memory",
    "seed": {}
  },
  "task": {
    "natural_goal": "顾客下单，店员接单后直接让顾客取餐（跳过做好这一步）。",
    "goal_assertions": [
      {
        "kind": "field_equals",
        "selector": {
          "collection": "orders",
          "index": 0
        },
        "path": "status",
        "value": "PICKED"
      }
    ]
  },
  "reference_trajectory": [
    {
      "id": "s1",
      "capability": "order.create",
      "as": "customer",
      "expected_outcome": "applied",
      "arguments": {
        "items": [
          {
            "dishName": "拿铁",
            "qty": 1
          }
        ]
      }
    },
    {
      "id": "s2",
      "capability": "kitchen.accept",
      "as": "staff",
      "expected_outcome": "applied",
      "bindings": {
        "orderId": "$s1.orderId"
      }
    },
    {
      "id": "s3",
      "capability": "order.pick",
      "as": "customer",
      "expected_outcome": "applied",
      "bindings": {
        "orderId": "$s1.orderId"
      }
    }
  ],
  "observability": {
    "declared_scopes": [
      "menu",
      "orders",
      "status_log"
    ]
  }
}
