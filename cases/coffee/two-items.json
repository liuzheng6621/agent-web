{
  "schema_version": "agent-web/0.1",
  "id": "coffee/two-items",
  "environment": {
    "adapter": "memory",
    "reset_strategy": "identity",
    "scopes": [
      "orders",
      "menu",
      "status_log"
    ]
  },
  "task": {
    "allowed_capabilities": [
      "order.create",
      "kitchen.accept",
      "kitchen.ready",
      "order.pick"
    ],
    "goal_assertions": [
      {
        "kind": "entity_exists",
        "selector": {
          "collection": "orders"
        }
      },
      {
        "kind": "field_equals",
        "selector": {
          "collection": "orders",
          "index": 0
        },
        "path": "status",
        "value": "PICKED"
      },
      {
        "kind": "count_delta",
        "selector": {
          "collection": "orders"
        },
        "delta": 1
      },
      {
        "kind": "field_equals",
        "selector": {
          "collection": "orders",
          "index": 0
        },
        "path": "totalAmount",
        "value": 122
      },
      {
        "kind": "relation",
        "op": "sum_equals",
        "selector": {
          "collection": "orders",
          "index": 0
        },
        "items": "items",
        "of": "subTotal",
        "path": "totalAmount"
      },
      {
        "kind": "relation",
        "op": "product_equals",
        "selector": {
          "collection": "orders",
          "index": 0
        },
        "items": "items",
        "left": "count",
        "right": "unitPrice",
        "path": "subTotal"
      },
      {
        "kind": "status_transition",
        "selector": {
          "collection": "orders",
          "index": 0
        },
        "path": "status",
        "transitions": [
          [
            "PENDING",
            "MAKING"
          ],
          [
            "MAKING",
            "READY"
          ],
          [
            "READY",
            "PICKED"
          ]
        ]
      }
    ],
    "invariants": [
      {
        "kind": "count_delta",
        "selector": {
          "collection": "status_log",
          "where": [
            {
              "field": "type",
              "eq": "order.canceled"
            }
          ]
        },
        "delta": 0
      }
    ],
    "natural_goal": "顾客一次点两种饮品（拿铁两杯、美式咖啡三杯），店员接单出餐后顾客自己取走；总价必须等于明细之和，每条明细的小计必须等于单价乘数量。"
  },
  "reference_trajectory": [
    {
      "id": "s1",
      "capability": "order.create",
      "as": "customer",
      "expected_outcome": "applied",
      "arguments": {
        "items": [
          {
            "dishName": "拿铁",
            "qty": 2
          },
          {
            "dishName": "美式咖啡",
            "qty": 3
          }
        ]
      }
    },
    {
      "id": "s2",
      "capability": "kitchen.accept",
      "as": "staff",
      "expected_outcome": "applied",
      "bindings": {
        "orderId": "$s1.orderId"
      }
    },
    {
      "id": "s3",
      "capability": "kitchen.ready",
      "as": "staff",
      "expected_outcome": "applied",
      "bindings": {
        "orderId": "$s1.orderId"
      }
    },
    {
      "id": "s4",
      "capability": "order.pick",
      "as": "customer",
      "expected_outcome": "applied",
      "bindings": {
        "orderId": "$s1.orderId"
      }
    }
  ]
}
