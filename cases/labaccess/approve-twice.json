{
  "schema_version": "agent-web/0.1",
  "id": "labaccess/approve-twice",
  "environment": {
    "adapter": "labaccess"
  },
  "task": {
    "natural_goal": "批准只发生一次：已经批过的预约再批一次必须被挡住，不该悄悄记第二笔",
    "goal_assertions": [
      {
        "kind": "count_delta",
        "selector": {
          "collection": "reservations"
        },
        "delta": 1
      },
      {
        "kind": "field_equals",
        "selector": {
          "collection": "reservations",
          "index": 0
        },
        "path": "status",
        "value": "approved"
      }
    ],
    "invariants": [
      {
        "kind": "unchanged",
        "scopes": [
          "equipment"
        ]
      }
    ]
  },
  "reference_trajectory": [
    {
      "id": "s1",
      "capability": "reservations.create",
      "as": "student",
      "arguments": {
        "startsInMinutes": 360,
        "durationMinutes": 30,
        "purpose": "twice"
      },
      "expected_outcome": "applied"
    },
    {
      "id": "s2",
      "capability": "reservations.approve",
      "as": "teacher",
      "arguments": {
        "reservationId": "$s1.reservationId"
      },
      "expected_outcome": "applied"
    },
    {
      "id": "s3",
      "capability": "reservations.approve",
      "as": "teacher",
      "arguments": {
        "reservationId": "$s1.reservationId"
      },
      "expected_outcome": "rejected"
    }
  ],
  "observability": {
    "declared_scopes": [
      "labs",
      "reservations",
      "equipment",
      "borrows"
    ]
  }
}
