{
  "schema_version": "agent-web/0.1",
  "id": "labaccess/reservation-approval",
  "environment": {
    "adapter": "labaccess"
  },
  "task": {
    "natural_goal": "学生提交预约，教师批准，学生拿到一次性门禁口令",
    "goal_assertions": [
      {
        "kind": "count_delta",
        "selector": {
          "collection": "reservations"
        },
        "delta": 1
      },
      {
        "kind": "field_equals",
        "selector": {
          "collection": "reservations",
          "index": 0
        },
        "path": "status",
        "value": "approved"
      },
      {
        "kind": "payload",
        "step": 1,
        "path": "$.reservationId",
        "op": "exists"
      }
    ],
    "invariants": [
      {
        "kind": "unchanged",
        "scopes": [
          "equipment"
        ]
      }
    ]
  },
  "reference_trajectory": [
    {
      "id": "s1",
      "capability": "reservations.create",
      "as": "student",
      "arguments": {
        "startsInMinutes": 120,
        "durationMinutes": 30
      },
      "expected_outcome": "applied"
    },
    {
      "id": "s2",
      "capability": "reservations.approve",
      "as": "teacher",
      "arguments": {
        "reservationId": "$s1.reservationId"
      },
      "expected_outcome": "applied"
    }
  ],
  "observability": {
    "declared_scopes": [
      "labs",
      "reservations",
      "equipment",
      "borrows"
    ]
  }
}
