{
  "schema_version": "agent-web/0.1",
  "id": "ledger/reject-unbalanced",
  "environment": {
    "adapter": "ledger-a",
    "seed": {}
  },
  "task": {
    "natural_goal": "借贷差 10 块的账必须记不进去，账本一条不能多。",
    "goal_assertions": [
      {
        "kind": "count_delta",
        "selector": {
          "collection": "transactions"
        },
        "delta": 0
      },
      {
        "kind": "unchanged",
        "scopes": [
          "transactions"
        ]
      },
      {
        "kind": "entity_exists",
        "selector": {
          "collection": "accounts"
        },
        "min": 2
      }
    ]
  },
  "reference_trajectory": [
    {
      "capability": "account.create",
      "as": "clerk",
      "expected_outcome": "applied",
      "arguments": {
        "name": "现金",
        "type": "asset"
      },
      "id": "s1"
    },
    {
      "capability": "account.create",
      "as": "clerk",
      "expected_outcome": "applied",
      "arguments": {
        "name": "主营收入",
        "type": "income"
      },
      "id": "s2"
    },
    {
      "id": "s3",
      "capability": "transaction.post",
      "as": "clerk",
      "expected_outcome": "rejected",
      "arguments": {
        "description": "借方 100 贷方 90",
        "entries": [
          {
            "accountId": 1,
            "direction": "debit",
            "amount": 100
          },
          {
            "accountId": 2,
            "direction": "credit",
            "amount": 90
          }
        ]
      }
    }
  ],
  "observability": {
    "declared_scopes": [
      "accounts",
      "transactions",
      "trial"
    ]
  }
}
