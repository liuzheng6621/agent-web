{
  "schema_version": "agent-web/0.1",
  "id": "ledger/reject-unknown-account",
  "environment": {
    "adapter": "ledger-a",
    "seed": {}
  },
  "task": {
    "natural_goal": "往不存在的账户记账必须记不进去。",
    "goal_assertions": [
      {
        "kind": "count_delta",
        "selector": {
          "collection": "transactions"
        },
        "delta": 0
      },
      {
        "kind": "unchanged",
        "scopes": [
          "transactions"
        ]
      }
    ]
  },
  "reference_trajectory": [
    {
      "capability": "account.create",
      "as": "clerk",
      "expected_outcome": "applied",
      "arguments": {
        "name": "现金",
        "type": "asset"
      },
      "id": "s1"
    },
    {
      "capability": "account.create",
      "as": "clerk",
      "expected_outcome": "applied",
      "arguments": {
        "name": "主营收入",
        "type": "income"
      },
      "id": "s2"
    },
    {
      "id": "s3",
      "capability": "transaction.post",
      "as": "clerk",
      "expected_outcome": "rejected",
      "arguments": {
        "description": "账户 999 不存在",
        "entries": [
          {
            "accountId": 1,
            "direction": "debit",
            "amount": 50
          },
          {
            "accountId": 999,
            "direction": "credit",
            "amount": 50
          }
        ]
      }
    }
  ],
  "observability": {
    "declared_scopes": [
      "accounts",
      "transactions",
      "trial"
    ]
  }
}
