{
  "schema_version": "agent-web/0.1",
  "id": "warehouse/happy-path",
  "environment": { "adapter": "warehouse-template", "seed": {} },
  "task": {
    "natural_goal": "制单员开一张出库单，走完提交、审批、发货，库存相应扣减。",
    "allowed_capabilities": ["picking.create", "picking.submit", "picking.approve", "picking.ship"],
    "preconditions": [
      { "kind": "entity_exists", "selector": { "collection": "stock" }, "min": 3 }
    ],
    "goal_assertions": [
      { "kind": "entity_exists", "selector": { "collection": "pickings" } },
      {
        "kind": "field_equals",
        "selector": { "collection": "pickings", "index": 0 },
        "path": "status",
        "value": "SHIPPED"
      },
      {
        "kind": "status_transition",
        "selector": { "collection": "pickings", "index": 0 },
        "path": "status",
        "transitions": [["DRAFT", "SUBMITTED"], ["SUBMITTED", "APPROVED"], ["APPROVED", "SHIPPED"]]
      },
      {
        "kind": "field_equals",
        "selector": { "collection": "stock", "where": [{ "field": "sku", "eq": "SKU-001" }] },
        "path": "onHand",
        "value": 95
      },
      { "kind": "count_delta", "selector": { "collection": "events" }, "delta": 4 }
    ],
    "invariants": [{ "kind": "event_absent", "type": "picking.canceled" }]
  },
  "reference_trajectory": [
    {
      "id": "s1",
      "capability": "picking.create",
      "as": "clerk",
      "expected_outcome": "applied",
      "arguments": { "sku": "SKU-001", "qty": 5 }
    },
    {
      "id": "s2",
      "capability": "picking.submit",
      "as": "clerk",
      "expected_outcome": "applied",
      "bindings": { "pickingId": "$s1.pickingId" }
    },
    {
      "id": "s3",
      "capability": "picking.approve",
      "as": "manager",
      "expected_outcome": "applied",
      "bindings": { "pickingId": "$s1.pickingId" }
    },
    {
      "id": "s4",
      "capability": "picking.ship",
      "as": "manager",
      "expected_outcome": "applied",
      "bindings": { "pickingId": "$s1.pickingId" }
    }
  ],
  "observability": { "declared_scopes": ["stock", "pickings", "events"] }
}
