{
  "name": "agent-web",
  "version": "0.64.0",
  "description": "给 Agent 写机器可判的集成测试：一份案例，多个实现，判决必须一致。",
  "type": "module",
  "bin": {
    "agent-web": "bin/agent-web.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./case": "./src/case.mjs",
    "./runner": "./src/runner.mjs",
    "./report": "./src/report.mjs",
    "./adapter/memory": "./src/adapter/memory.mjs",
    "./adapter/taixianglian": "./src/adapter/taixianglian.mjs",
    "./record": "./src/record.mjs",
    "./draft": "./src/draft.mjs",
    "./flow": "./src/flow.mjs",
    "./audit": "./src/audit.mjs",
    "./coverage": "./src/coverage.mjs",
    "./traps": "./src/traps.mjs",
    "./certify": "./src/certify.mjs",
    "./mutate": "./src/mutate.mjs",
    "./mutants": "./docs/mutants/index.mjs",
    "./drill": "./src/drill.mjs",
    "./probe": "./src/probe.mjs",
    "./knowledge": "./knowledge/index.mjs",
    "./recall": "./src/recall.mjs",
    "./discover": "./src/discover.mjs",
    "./breed": "./src/breed.mjs",
    "./assert/shape": "./src/assert/shape.mjs",
    "./yaml": "./src/yaml.mjs",
    "./tap": "./src/tap.mjs",
    "./learn": "./src/learn.mjs",
    "./adapter/decl": "./src/adapter/decl.mjs",
    "./adapter/twin": "./src/adapter/twin.mjs",
    "./drill-ledger": "./src/drill-ledger.mjs",
    "./align": "./src/align.mjs",
    "./import-hurl": "./src/import-hurl.mjs",
    "./crosscheck": "./src/crosscheck.mjs"
  },
  "scripts": {
    "test": "node --test test/engine.test.mjs test/traps.test.mjs test/museum.test.mjs test/certify.test.mjs test/drill.test.mjs test/relation.test.mjs test/probe.test.mjs test/recall.test.mjs test/discover.test.mjs test/breed.test.mjs test/shape.test.mjs test/animal-tracking.test.mjs test/help.test.mjs test/tap-learn.test.mjs test/limits.test.mjs test/drill-ledger.test.mjs test/align.test.mjs test/window.test.mjs test/pagination.test.mjs test/cli-flags.test.mjs test/domain-animal.test.mjs test/import-hurl.test.mjs test/linkage.test.mjs test/breed-manifest.test.mjs test/determinism.test.mjs test/negatives.test.mjs test/preflight.test.mjs test/lexicon.test.mjs test/timeliness.test.mjs test/negatives-observed.test.mjs test/state-machine.test.mjs test/breed-ops.test.mjs test/roadmap.test.mjs test/crosscheck.test.mjs test/readme-boundary.test.mjs test/realworld-compare.test.mjs test/report-counts.test.mjs test/domain-labaccess.test.mjs test/ingest.test.mjs test/recurrence.test.mjs test/domain-cron.test.mjs test/outcome-contract.test.mjs test/precheck-manifest.test.mjs test/step-outcome.test.mjs test/unknown-reason.test.mjs test/exit-codes.test.mjs test/reasons.test.mjs test/clock-policy.test.mjs test/certify-applicability.test.mjs",
    "selftest": "node bin/agent-web.mjs selftest",
    "compare": "node bin/agent-web.mjs compare cases/coffee --adapters=memory,taixianglian",
    "gh-proxy": "node scripts/gh-proxy.mjs",
    "museum": "node --test test/museum.test.mjs",
    "traps": "node bin/agent-web.mjs traps",
    "certify": "node bin/agent-web.mjs certify cases/coffee --adapter=memory --detail",
    "mutants": "node bin/agent-web.mjs mutants",
    "drill": "node bin/agent-web.mjs drill cases/coffee --adapter=memory",
    "certify:baseline": "node scripts/certify-baseline.mjs",
    "probe": "node bin/agent-web.mjs probe --adapter=memory --detail",
    "knowledge": "node bin/agent-web.mjs knowledge",
    "recall": "node bin/agent-web.mjs recall",
    "discover": "node bin/agent-web.mjs discover",
    "breed": "node bin/agent-web.mjs breed --adapter=memory --from-case=cases/coffee/happy-path.json --out=.tmp-bred",
    "kind-necessity": "node scripts/kind-necessity.mjs",
    "status-line": "node scripts/status-line.mjs",
    "tap": "node bin/agent-web.mjs tap",
    "learn": "node bin/agent-web.mjs learn",
    "import": "node bin/agent-web.mjs import hurl",
    "determinism": "node scripts/verdict-determinism.mjs cases/coffee --adapter=memory --repeat=2",
    "determinism:baseline": "node scripts/verdict-determinism.mjs cases/coffee --adapter=memory --out=.agent-web/determinism/baseline.json",
    "determinism:check": "node scripts/verdict-determinism.mjs cases/coffee --adapter=memory --check=.agent-web/determinism/baseline.json",
    "preflight": "node bin/agent-web.mjs preflight cases/coffee --adapter=memory"
  },
  "keywords": [
    "agent",
    "testing",
    "evaluation",
    "assertions",
    "integration-test",
    "audit"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "cases",
    "examples",
    "docs",
    "scripts",
    "README.md",
    "README.en.md",
    "VERSION",
    "LICENSE"
  ]
}
