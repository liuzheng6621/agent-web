{
  "name": "agent-web",
  "version": "0.4.0",
  "description": "给 Agent 写机器可判的集成测试：一份案例，多个实现，判决必须一致。",
  "type": "module",
  "bin": {
    "agent-web": "bin/agent-web.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./case": "./src/case.mjs",
    "./runner": "./src/runner.mjs",
    "./report": "./src/report.mjs",
    "./adapter/memory": "./src/adapter/memory.mjs",
    "./adapter/taixianglian": "./src/adapter/taixianglian.mjs",
    "./record": "./src/record.mjs",
    "./draft": "./src/draft.mjs"
  },
  "scripts": {
    "test": "node --test test/engine.test.mjs",
    "selftest": "node bin/agent-web.mjs selftest",
    "compare": "node bin/agent-web.mjs compare cases/memory-demo --adapters=memory,taixianglian"
  },
  "keywords": [
    "agent",
    "testing",
    "evaluation",
    "assertions",
    "integration-test"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin",
    "src",
    "cases",
    "examples",
    "docs",
    "scripts",
    "README.md",
    "README.en.md",
    "LICENSE"
  ]
}
